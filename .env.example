# Is file ko copy karke .env banao aur apni asli key yahan likho.
# .env GitHub par kabhi upload nahi hoti (.gitignore mein hai).
# Asli key is .env.example mein mat likhna.

GROQ_API_KEY=yahan_apni_groq_key_likho

# Optional: model ka naam (khali chhor do to app khud chun leti hai)
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: ek visitor 1 minute mein kitne messages bhej sakta hai
# RATE_LIMIT_PER_MIN=15
